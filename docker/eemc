FROM nvidia/cuda:12.6.3-cudnn-devel-ubuntu24.04 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-dev \
    python3-pip \
    git \
    cmake \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN pip install --break-system-packages --user torch==2.9.1+cu126 --index-url https://download.pytorch.org/whl/cu126


